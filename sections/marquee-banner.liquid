<div class="marquee-banner">
  <div class="marquee-banner__track lv-marquee">
    {%- for i in (1..2) -%}
      <div class="marquee-banner__group">
        {%- for j in (1..6) -%}
          {%- assign text_key = 'item_' | append: j -%}
          {%- if section.settings[text_key] != blank -%}
            <span class="marquee-banner__item lv-text-eyebrow">
              {{ section.settings[text_key] }}
              <span aria-hidden="true" class="marquee-banner__dot">✦</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .marquee-banner {
    overflow: hidden;
    border-top: 1px solid var(--lv-border);
    border-bottom: 1px solid var(--lv-border);
    background-color: var(--lv-background);
    padding-block: 1.25rem;
  }

  .marquee-banner__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    gap: 4rem;
  }

  .marquee-banner__group {
    display: flex;
    gap: 4rem;
  }

  .marquee-banner__item {
    display: flex;
    align-items: center;
    gap: 4rem;
    color: var(--lv-foreground);
  }

  .marquee-banner__dot {
    color: var(--lv-muted-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-banner__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
