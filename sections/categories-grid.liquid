<div class="categories-grid">

  <p class="lv-text-eyebrow categories-grid__label">{{ section.settings.eyebrow | default: 'Categories' }}</p>

  <div class="categories-grid__grid">
    {%- for i in (1..3) -%}
      {%- assign col_key = 'collection_' | append: i -%}
      {%- assign col = collections[section.settings[col_key]] -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="categories-grid__item">
          {%- if col.featured_image -%}
            {{
              col.featured_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                class: 'categories-grid__image',
                alt: col.title,
                sizes: '(min-width: 1024px) 33vw, 100vw',
                widths: '400, 600, 800'
            }}
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'categories-grid__image' }}
          {%- endif -%}
          <div class="categories-grid__overlay">
            <h3 class="lv-font-display categories-grid__name">{{ col.title }}</h3>
            <span class="lv-text-eyebrow categories-grid__count">
              {%- assign count = col.products_count -%}
              {%- if count < 10 -%}0{%- endif -%}{{ count }} styles →
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>

{% stylesheet %}
  .categories-grid {
    padding: 5rem 1.5rem 10rem;
  }

  @media screen and (min-width: 1024px) {
    .categories-grid {
      padding: 7rem 2.5rem 14rem;
    }
  }

  .categories-grid__label {
    color: var(--lv-muted-foreground);
    margin: 0;
  }

  .categories-grid__grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--lv-border);
  }

  @media screen and (min-width: 768px) {
    .categories-grid__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .categories-grid__item {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: var(--lv-background);
    text-decoration: none;
  }

  .categories-grid__image {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms ease-out;
  }

  .categories-grid__item:hover .categories-grid__image {
    transform: scale(1.02);
  }

  .categories-grid__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    background: linear-gradient(to top, rgb(28 26 24 / 0.4), transparent);
    padding: 1.5rem;
    color: var(--lv-background);
  }

  .categories-grid__name {
    font-size: 1.875rem;
    font-weight: 400;
    margin: 0;
    line-height: 1;
  }

  .categories-grid__count {
    color: var(--lv-background);
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Categories Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Categories"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    }
  ],
  "presets": [
    {
      "name": "Categories Grid"
    }
  ]
}
{% endschema %}
