<div class="collection-header">
  <p class="lv-text-eyebrow collection-header__eyebrow">
    {{ collection.title }} /
    {%- if section.settings.season_label != blank -%}
      {{ section.settings.season_label }}
    {%- else -%}
      SS·{{ 'now' | date: '%y' }}
    {%- endif -%}
  </p>
  <div class="collection-header__bottom">
    <h1 class="lv-font-display collection-header__title">
      {{ collection.title }}
    </h1>
    <p class="collection-header__count">
      {{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %} in current rotation.
    </p>
  </div>
</div>

{% stylesheet %}
  .collection-header {
    border-bottom: 1px solid var(--lv-border);
    padding-block: 2rem;
    padding-inline: max(1.5rem, calc((100% - 90rem) / 2));
  }

  @media screen and (min-width: 1024px) {
    .collection-header {
      padding-block: 4rem;
      padding-inline: max(2.5rem, calc((100% - 90rem) / 2));
    }
  }

  .collection-header__eyebrow {
    color: var(--lv-muted-foreground);
    margin: 0;
  }

  .collection-header__bottom {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media screen and (min-width: 768px) {
    .collection-header__bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .collection-header__title {
    font-size: 3rem;
    line-height: 0.95;
    font-weight: 400;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .collection-header__title {
      font-size: 4.5rem;
    }
  }

  .collection-header__count {
    font-size: 0.875rem;
    color: var(--lv-muted-foreground);
    max-width: 20rem;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Header",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "season_label",
      "label": "Season label",
      "info": "For example, AW·26 or SS·27. Leave blank to use the current SS year."
    }
  ],
  "presets": []
}
{% endschema %}
