{% liquid
  assign blog = blogs[section.settings.blog]
  assign articles_to_show = section.settings.articles_to_show | default: 3
%}

<div class="journal-editorial">

  <div class="journal-editorial__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lv-text-eyebrow journal-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lv-font-display journal-editorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if blog != blank -%}
      <a href="{{ blog.url }}" class="lv-text-eyebrow lv-hover-underline journal-editorial__view-all">
        {{ section.settings.view_all_label | default: 'All articles' }} →
      </a>
    {%- endif -%}
  </div>

  <div class="journal-editorial__grid">
    {%- for article in blog.articles limit: articles_to_show -%}
      {%- liquid
        assign word_count = article.content | strip_html | split: ' ' | size
        assign read_time = word_count | divided_by: 200 | plus: 1
        assign category = article.tags | first
      -%}
      <a href="{{ article.url }}" class="journal-editorial__card">
        <div class="journal-editorial__media">
          {%- if article.image != blank -%}
            {{
              article.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                class: 'journal-editorial__image',
                alt: article.image.alt | default: article.title,
                sizes: '(min-width: 768px) 33vw, 100vw',
                widths: '400, 600, 800'
            }}
          {%- else -%}
            <div class="journal-editorial__image journal-editorial__image--placeholder">
              {{ 'image' | placeholder_svg_tag: 'journal-editorial__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
        <p class="lv-text-eyebrow journal-editorial__meta">
          {%- if category != blank -%}{{ category }}{%- else -%}Journal{%- endif -%}
          &nbsp;·&nbsp;{{ read_time }} min
        </p>
        <h3 class="lv-font-display journal-editorial__title">{{ article.title }}</h3>
        <p class="journal-editorial__excerpt">
          {{ article.excerpt_or_content | strip_html | truncate: 130 }}
        </p>
        <p class="lv-text-eyebrow journal-editorial__date">
          {{ article.published_at | date: '%b %d, %Y' }}
        </p>
      </a>
    {%- else -%}
      {%- for i in (1..articles_to_show) -%}
        <div class="journal-editorial__card journal-editorial__card--placeholder">
          <div class="journal-editorial__media">
            <div class="journal-editorial__image journal-editorial__image--placeholder">
              {{ 'image' | placeholder_svg_tag: 'journal-editorial__placeholder-svg' }}
            </div>
          </div>
          <p class="lv-text-eyebrow journal-editorial__meta">Category · 4 min</p>
          <h3 class="lv-font-display journal-editorial__title">Article title goes here</h3>
          <p class="journal-editorial__excerpt">A short excerpt from the article appears here, giving readers a sense of what to expect inside.</p>
          <p class="lv-text-eyebrow journal-editorial__date">May 01, 2026</p>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

</div>

{% stylesheet %}
  .journal-editorial {
    padding-block: 0 5rem;
    padding-inline: max(1.5rem, calc((100% - 90rem) / 2));
  }

  @media screen and (min-width: 1024px) {
    .journal-editorial {
      padding-block: 0 7rem;
      padding-inline: max(2.5rem, calc((100% - 90rem) / 2));
    }
  }

  /* ── Header ── */
  .journal-editorial__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  @media screen and (min-width: 1024px) {
    .journal-editorial__header {
      margin-bottom: 3.5rem;
    }
  }

  .journal-editorial__eyebrow {
    color: var(--lv-muted-foreground);
    margin: 0;
  }

  .journal-editorial__heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    margin: 0.75rem 0 0;
  }

  .journal-editorial__view-all {
    display: none;
    text-decoration: none;
    color: var(--lv-foreground);
    white-space: nowrap;
    margin-bottom: 0.25rem;
  }

  @media screen and (min-width: 768px) {
    .journal-editorial__view-all {
      display: inline-flex;
    }
  }

  /* ── Grid ── */
  .journal-editorial__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media screen and (min-width: 768px) {
    .journal-editorial__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 1.5rem;
      row-gap: 3rem;
    }
  }

  /* ── Card ── */
  .journal-editorial__card {
    display: block;
    text-decoration: none;
    color: var(--lv-foreground);
  }

  /* ── Media ── */
  .journal-editorial__media {
    overflow: hidden;
  }

  .journal-editorial__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .journal-editorial__card:hover .journal-editorial__image {
    transform: scale(1.03);
  }

  .journal-editorial__image--placeholder {
    background-color: var(--lv-stone-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journal-editorial__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  /* ── Card text ── */
  .journal-editorial__meta {
    color: var(--lv-muted-foreground);
    margin: 1.25rem 0 0;
  }

  .journal-editorial__title {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 0.75rem 0 0;
  }

  .journal-editorial__excerpt {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--lv-muted-foreground);
    margin: 0.75rem 0 0;
  }

  .journal-editorial__date {
    color: var(--lv-muted-foreground);
    margin: 1.25rem 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal / Field Notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words on the work."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "All articles"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Journal Editorial"
    }
  ]
}
{% endschema %}
