{% liquid
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show | default: 6
%}

<div class="products-editorial">

  <div class="products-editorial__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lv-text-eyebrow products-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lv-font-display products-editorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if collection != blank -%}
      <a href="{{ collection.url }}" class="lv-text-eyebrow lv-hover-underline products-editorial__view-all">
        {{ section.settings.view_all_label | default: 'View all' }} ({{ collection.products_count }}) →
      </a>
    {%- endif -%}
  </div>

  <div class="products-editorial__grid">
    {%- for product in collection.products limit: products_to_show -%}
      {%- liquid
        assign color_option_index = nil
        for option in product.options
          assign option_downcase = option | downcase
          if option_downcase == 'color' or option_downcase == 'colour'
            assign color_option_index = forloop.index0
            break
          endif
        endfor

        assign color_values = ''
        if color_option_index != nil
          for variant in product.variants
            assign color_val = variant.options[color_option_index]
            unless color_values contains color_val
              assign color_values = color_values | append: color_val | append: '|'
            endunless
          endfor
          assign color_values = color_values | split: '|' | compact
        endif

        assign badge = nil
        if product.tags contains 'new'
          assign badge = 'New'
        elsif product.available == false
          assign badge = 'Sold out'
        endif
      -%}

      <a href="{{ product.url }}" class="products-editorial__card group">

        <div class="products-editorial__media">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                class: 'products-editorial__image',
                alt: product.featured_image.alt | default: product.title,
                sizes: '(min-width: 1024px) 33vw, 50vw',
                widths: '400, 600, 800'
            }}
          {%- else -%}
            <div class="products-editorial__image-placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}

          {%- if badge != nil -%}
            <span class="lv-text-eyebrow products-editorial__badge">{{ badge }}</span>
          {%- endif -%}

          <div class="products-editorial__quick-add">
            <span class="lv-text-eyebrow products-editorial__quick-add-btn">
              {{ 'products.product.add_to_cart' | t }}
            </span>
          </div>
        </div>

        <div class="products-editorial__info">
          <div>
            <p class="lv-text-eyebrow products-editorial__category">{{ product.type | default: product.vendor }}</p>
            <h3 class="products-editorial__title">{{ product.title }}</h3>
            {%- if color_values.size > 0 -%}
              <div class="products-editorial__colors">
                {%- for color in color_values -%}
                  <span class="products-editorial__color">
                    {{- color -}}{%- unless forloop.last -%} ·{%- endunless -%}
                  </span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <p class="products-editorial__price">{{ product.price | money_without_currency }}</p>
        </div>

      </a>
    {%- else -%}
      {%- for i in (1..products_to_show) -%}
        <div class="products-editorial__card">
          <div class="products-editorial__media products-editorial__media--placeholder">
            {{ 'product-' | append: i | placeholder_svg_tag: 'products-editorial__image' }}
          </div>
          <div class="products-editorial__info">
            <div>
              <p class="lv-text-eyebrow products-editorial__category">Category</p>
              <h3 class="products-editorial__title">Product title</h3>
            </div>
            <p class="products-editorial__price">0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

</div>

{% stylesheet %}
  .products-editorial {
    padding: 5rem 1.5rem;
  }

  @media screen and (min-width: 1024px) {
    .products-editorial {
      padding: 7rem 2.5rem;
    }
  }

  /* ── Header ── */
  .products-editorial__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .products-editorial__eyebrow {
    color: var(--lv-muted-foreground);
    margin: 0;
  }

  .products-editorial__heading {
    font-size: 2.25rem;
    margin: 0.75rem 0 0;
    font-weight: 400;
    line-height: 1;
  }

  @media screen and (min-width: 768px) {
    .products-editorial__heading {
      font-size: 3rem;
    }
  }

  .products-editorial__view-all {
    display: none;
    text-decoration: none;
    color: var(--lv-foreground);
    white-space: nowrap;
  }

  @media screen and (min-width: 768px) {
    .products-editorial__view-all {
      display: inline-flex;
    }
  }

  /* ── Grid ── */
  .products-editorial__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1rem;
    row-gap: 3rem;
  }

  @media screen and (min-width: 768px) {
    .products-editorial__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .products-editorial__grid {
      column-gap: 1.5rem;
    }
  }

  /* ── Card ── */
  .products-editorial__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* ── Media ── */
  .products-editorial__media {
    position: relative;
    overflow: hidden;
    background-color: var(--lv-bone);
  }

  .products-editorial__image {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
    display: block;
    transition: transform 900ms ease-out;
  }

  .products-editorial__card:hover .products-editorial__image {
    transform: scale(1.03);
  }

  .products-editorial__media--placeholder {
    aspect-ratio: 4 / 5;
  }

  /* ── Badge ── */
  .products-editorial__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--lv-background);
    padding: 0.25rem 0.5rem;
  }

  /* ── Quick add ── */
  .products-editorial__quick-add {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    transform: translateY(0.75rem);
    opacity: 0;
    transition: transform 500ms ease, opacity 500ms ease;
  }

  .products-editorial__card:hover .products-editorial__quick-add {
    transform: translateY(0);
    opacity: 1;
  }

  .products-editorial__quick-add-btn {
    display: block;
    width: 100%;
    background-color: var(--lv-ink);
    color: var(--lv-background);
    padding: 0.75rem;
    text-align: center;
  }

  /* ── Info ── */
  .products-editorial__info {
    margin-top: 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .products-editorial__category {
    color: var(--lv-muted-foreground);
    margin: 0;
  }

  .products-editorial__title {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .products-editorial__colors {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .products-editorial__color {
    font-size: 0.625rem;
    color: var(--lv-muted-foreground);
  }

  .products-editorial__price {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Now / Selected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Six pieces. No noise."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Products Editorial"
    }
  ]
}
{% endschema %}
