{% doc %}
  Renders JSON-LD structured data for SEO:
  - WebSite + SearchAction on the homepage (enables Google sitelinks search box)
  - BreadcrumbList on product / collection / article / page templates (enables breadcrumb rich snippets in SERP)

  Organization, Product, and Article schemas are NOT duplicated here; Shopify auto-injects
  Organization via {{ content_for_header }}, and Product/Article schemas live in their
  respective section files (product-information, featured-product, main-blog-post).
{% enddoc %}

{%- if template.name == 'index' -%}
  {%- capture search_url_template -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: '/' | json }},
      "inLanguage": "en-PK",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_url_template | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if template.name == 'product' and product -%}
  {%- assign product_type_handle = product.type | handle -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | append: '/' | json }}
        }
        {%- if product.type != blank -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.type | json }},
          "item": {{ shop.url | append: '/collections/' | append: product_type_handle | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ shop.url | append: product.url | json }}
        }
        {%- else -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ shop.url | append: product.url | json }}
        }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

